{
  "name": "jesherhead",
  "version": "1.0.2",
  "description": "Game hub with 1000+ games, panic key, tab cloaking, and offline support",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesherhead/jesherhead.git"
  },
  "keywords": [
    "games",
    "pwa",
    "game-hub"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jesherhead/jesherhead/issues"
  },
  "homepage": "https://github.com/jesherhead/jesherhead#readme",
  "dependencies": {
    "posthog-js": "^1.434.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
